# ==========================================
# AI Resume Tailor & Proposal Generator Configuration
# ==========================================

# AI Provider Configuration
# Supported providers: "openai", "gemini", "anthropic", "groq", "openrouter"
AI_PROVIDER=openai

# Model to use (e.g., gpt-4o-mini, gpt-4o, gemini-2.0-flash, claude-3-5-sonnet-latest)
AI_MODEL=gpt-4o-mini

# API key for the selected provider
AI_API_KEY=your-api-key-here

# Optional base URL for OpenAI-compatible endpoints (Ollama, vLLM, OpenRouter, Groq, etc.)
# AI_BASE_URL=https://api.openai.com/v1

# Maximum upload file size in Megabytes (default: 10)
MAX_UPLOAD_SIZE_MB=10

# Optional OCR integration toggle (false by default)
OCR_ENABLED=false
